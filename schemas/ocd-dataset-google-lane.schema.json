{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-carrier-data/open-carrier-data/main/schemas/ocd-dataset-google-lane.schema.json",
  "title": "OCD dataset Google lane (generated/ocd-dataset/google-lane.json)",
  "description": "The Google lane's values as OCD source family google (rule round 30, dataset spec 2.7): Google's CarrierSettings carrier_list of one Pixel in file order, flattened to one rule per carrier_id (Google's 000000 default rule not listed), and every entry's CarrierConfig values, `default` and `no_sim` included. Values, not Google's files (rule 2). On public main an IMSI rule is at most 13 characters and no value trips the privacy guard (rule 3): the private publisher leaves such values out. Each value has its key's type in schemas/carrier-config-keys.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "based_on_data_digest",
    "family",
    "provenance",
    "rules",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "based_on_data_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "family": {
      "const": "google"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "device",
        "build",
        "carrier_list_version",
        "others_version",
        "snapshot",
        "state"
      ],
      "properties": {
        "lane": {
          "const": "google_carriersettings"
        },
        "device": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
        },
        "build": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._]{1,39}$"
        },
        "carrier_list_version": {
          "type": "integer",
          "minimum": 0
        },
        "others_version": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "enum": [
            "public_main",
            "private_lane_at_build_pin"
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_name",
          "mcc",
          "mnc",
          "mvno"
        ],
        "properties": {
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "mcc": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "mnc": {
            "type": "string",
            "pattern": "^[0-9]{2,3}$"
          },
          "mvno": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "spn",
                      "imsi",
                      "gid1",
                      "iccid"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            ]
          }
        }
      }
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.]{1,200}$"
            }
          }
        }
      }
    }
  }
}
