{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-carrier-data/open-carrier-data/main/schemas/device-records.schema.json",
  "title": "OCD per-device records (generated/devices/device-records.json)",
  "description": "Per-device and per-carrier records for the owner's devices (rule round 30, item 4; dataset spec 2.10): measured records (the owner's settled results, 90-day expiry; rule round 31 ended the configured_device kind and the carrier scope all at its step 8), keyed by device, ROM line and IMS stack with its fork. A record never holds a phone number, IMSI, ICCID, IMEI, SIP URI or IP address. A group A record is served only with a second_agent_read naming a read record under devices/records/reads/ whose verdict is proceed; a group B record is refused. Sources: devices/records/; tools/ocd_dataset.py writes and checks the file, tools/observed_reports.py takes measured records from the owner's report issues ($defs.record).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "based_on_data_digest",
    "expire_days",
    "records"
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_key",
        "kind",
        "device",
        "rom",
        "ims_stack",
        "carrier",
        "target",
        "value_kind",
        "value",
        "claim",
        "label",
        "basis",
        "level",
        "result",
        "method",
        "bearer",
        "n",
        "first_measured",
        "last_measured",
        "valid_until",
        "data",
        "tester",
        "differs_between_sims",
        "second_agent_read"
      ],
      "properties": {
        "record_key": {
          "type": "string",
          "pattern": "^r:[0-9a-f]{16}$"
        },
        "kind": {
          "enum": [
            "measured"
          ]
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codename",
            "model"
          ],
          "properties": {
            "codename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,39}$"
            }
          }
        },
        "rom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "line"
          ],
          "properties": {
            "family": {
              "enum": [
                "lineageos",
                "stock",
                "other"
              ]
            },
            "line": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,15}$"
            }
          }
        },
        "ims_stack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "fork",
            "version"
          ],
          "properties": {
            "id": {
              "enum": [
                "aosp_imsstack",
                "phh_ims",
                "samsung_ims",
                "other"
              ]
            },
            "fork": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "carrier": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "profile_id"
              ],
              "properties": {
                "scope": {
                  "const": "profile"
                },
                "profile_id": {
                  "type": "string",
                  "pattern": "^(open|fill)\\.[0-9]{5,6}\\.[0-9a-f]{12}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "mcc",
                "mnc"
              ],
              "properties": {
                "scope": {
                  "const": "sim_key"
                },
                "mcc": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                },
                "mnc": {
                  "type": "string",
                  "pattern": "^[0-9]{2,3}$"
                },
                "gid1": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f]{1,32}$"
                },
                "spn": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key"
              ],
              "properties": {
                "type": {
                  "const": "config"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.]{1,200}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "row_key",
                "op"
              ],
              "properties": {
                "type": {
                  "const": "apn"
                },
                "row_key": {
                  "type": "string",
                  "pattern": "^a:[0-9a-f]{16}$"
                },
                "op": {
                  "const": "omit"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "row_key"
              ],
              "properties": {
                "type": {
                  "const": "emergency_data"
                },
                "row_key": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^a:[0-9a-f]{16}$"
                    }
                  ]
                }
              }
            }
          ]
        },
        "value_kind": {
          "enum": [
            "value",
            "android_default",
            "none"
          ]
        },
        "value": {
          "description": "A value of the registry type of target.key, or null when value_kind is not value."
        },
        "claim": {
          "enum": [
            "configured",
            "measured"
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "level": {
          "enum": [
            null,
            "L2",
            "L3",
            "sms_both_ways",
            "no_regression",
            "emergency_data"
          ]
        },
        "result": {
          "enum": [
            null,
            "works",
            "calls_out",
            "sms_both_ways",
            "no_regression_passed",
            "winner_after_failure",
            "no_value_passed",
            "emergency_data_accepted",
            "emergency_data_refused",
            "emergency_default_won"
          ]
        },
        "method": {
          "enum": [
            null,
            "mailbox_call",
            "real_call",
            "mailbox_call+real_call",
            "real_call+real_call",
            "self_sms",
            "observed",
            "override_trial",
            "eims_request"
          ]
        },
        "bearer": {
          "enum": [
            null,
            "lte",
            "nr",
            "iwlan"
          ]
        },
        "n": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          ]
        },
        "first_measured": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "last_measured": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "data_digest"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "data_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "tester": {
          "const": "owner"
        },
        "differs_between_sims": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "last_measured"
                ],
                "properties": {
                  "value": {},
                  "last_measured": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          ]
        },
        "second_agent_read": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reader",
                "read_at",
                "basis",
                "reference"
              ],
              "properties": {
                "reader": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "read_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "reference": {
                  "type": "string",
                  "pattern": "^devices/records/reads/r-[0-9a-f]{16}\\.json$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "based_on_data_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expire_days": {
      "const": 90
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
