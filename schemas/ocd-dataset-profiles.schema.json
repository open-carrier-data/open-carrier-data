{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-carrier-data/open-carrier-data/main/schemas/ocd-dataset-profiles.schema.json",
  "title": "OCD dataset profiles (generated/ocd-dataset/profiles.json)",
  "description": "Every network's profiles with OCD's match rules (rule round 30, dataset spec 2.5): the closed key registry, groups A, B and X6 as the data marks them, the reserved default and no_sim fills, and per network <mcc>-<mnc> (the MNC as the SIM reports it) the OCD profiles and the fill-only profiles of Google rules without an OCD profile, in specificity and id order. Each profile carries its own published values (not overlaid), their source families (the Google lane named google), alternatives, its APN row count and its ordered Google-lane fill list. tools/ocd_dataset.py checks every value against the registry type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "based_on_data_digest",
    "keys",
    "groups",
    "reserved",
    "networks"
  ],
  "$defs": {
    "registry_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "group",
        "origin",
        "fork"
      ],
      "properties": {
        "type": {
          "enum": [
            "bool",
            "int",
            "long",
            "double",
            "string",
            "string_array",
            "int_array",
            "bundle"
          ]
        },
        "group": {
          "enum": [
            "A",
            "B",
            "X6",
            null
          ]
        },
        "origin": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "device_record",
              "google",
              "ocd_schema"
            ]
          }
        },
        "fork": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          ]
        }
      }
    },
    "fill": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "when"
        ],
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "when": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "spn",
                      "imsi",
                      "gid1",
                      "iccid"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            ]
          }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mccmnc"
      ],
      "properties": {
        "mccmnc": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mcc",
              "mnc"
            ],
            "properties": {
              "mcc": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              },
              "mnc": {
                "type": "string",
                "pattern": "^[0-9]{2,3}$"
              }
            }
          }
        },
        "spn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "imsi_prefix_patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[0-9xX]{5,15}$"
          }
        },
        "gid1_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{1,32}$"
          }
        },
        "gid2_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{1,32}$"
          }
        },
        "iccid_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5,20}$"
          }
        },
        "android_carrier_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "match",
        "specificity",
        "fill",
        "values",
        "sources",
        "alternatives",
        "apn_rows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(open|fill)\\.[0-9]{5,6}\\.[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "ocd",
            "fill_only"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "specificity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "fill": {
          "$ref": "#/$defs/fill"
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,200}$"
          }
        },
        "sources": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,200}$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            }
          }
        },
        "alternatives": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,200}$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "families"
              ],
              "properties": {
                "value": {},
                "families": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,63}$"
                  }
                }
              }
            }
          }
        },
        "apn_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "based_on_data_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.]{1,200}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/registry_entry"
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "X6"
      ],
      "properties": {
        "A": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "names",
            "keys"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "names": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]{1,200}$"
              }
            },
            "keys": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]{1,200}$"
              }
            }
          }
        },
        "B": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys",
            "must_contain"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]{1,200}$"
              }
            },
            "must_contain": {
              "const": "default"
            }
          }
        },
        "X6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keys",
            "networks"
          ],
          "properties": {
            "keys": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.]{1,200}$"
              }
            },
            "networks": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{3}-[0-9]{2,3}$"
              }
            }
          }
        }
      }
    },
    "reserved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "no_sim"
      ],
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fill"
          ],
          "properties": {
            "fill": {
              "$ref": "#/$defs/fill"
            }
          }
        },
        "no_sim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fill"
          ],
          "properties": {
            "fill": {
              "$ref": "#/$defs/fill"
            }
          }
        }
      }
    },
    "networks": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9]{3}-[0-9]{2,3}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mcc",
          "mnc",
          "profiles"
        ],
        "properties": {
          "mcc": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "mnc": {
            "type": "string",
            "pattern": "^[0-9]{2,3}$"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/profile"
            }
          }
        }
      }
    }
  }
}
