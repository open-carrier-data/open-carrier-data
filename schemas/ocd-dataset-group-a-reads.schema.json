{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-carrier-data/open-carrier-data/main/schemas/ocd-dataset-group-a-reads.schema.json",
  "title": "OCD group A reads (generated/ocd-dataset/group-a-reads.json, role group_a_reads)",
  "description": "Rule round 31 (emergencyValues), the S20 spec's R31.7: the group A reads on main (devices/records/reads/group-a/) as OcdCarrierSettings serves them, one item per read, profile and source family, and the key findings. For each group A key CarrierSettings serves, with its own key pattern and names: (1) the value OCD's stack resolves, when it differs from the Google-lane value and a read with verdict proceed names that key, value, source family and profile and this phone's ROM family and IMS stack (a read naming the stack's fork wins over one without); (2) else the Google-lane value of the served dataset; (3) else Android's default. The ROM's device override applies after it. A hold keeps the Google-lane value. A key finding display_only with verdict proceed takes the key out of group A, except emergency_number_prefix_string_array, dial_string_replace_string_array and international_roaming_dial_string_replace_string_array. An optional dataset role: a reader of protocol 2 refuses a manifest that lists it. tools/ocd_dataset.py generate writes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "based_on_data_digest",
    "reads",
    "key_findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "based_on_data_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read_id",
          "key",
          "value",
          "family",
          "profile_id",
          "rom_family",
          "ims_stack",
          "ims_stack_fork",
          "verdict",
          "reader",
          "read_at",
          "reference"
        ],
        "properties": {
          "read_id": {
            "type": "string",
            "pattern": "^gar:[0-9a-f]{16}$",
            "description": "gar: and the first 16 hex digits of SHA-256 over the read record's path, the profile and the family, joined with \\n."
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,200}$"
          },
          "value": {
            "description": "The value read, typed by the key registry."
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$",
            "description": "One source family of the profile's value for the key; the read admits the value only where the profile's sources name it."
          },
          "profile_id": {
            "type": "string",
            "pattern": "^(open|fill)\\.[0-9]{5,6}\\.[0-9a-f]{12}$"
          },
          "rom_family": {
            "enum": [
              "aosp",
              "lineageos",
              "other",
              "stock"
            ]
          },
          "ims_stack": {
            "enum": [
              "aosp_imsstack",
              "other",
              "phh_ims",
              "samsung_ims"
            ]
          },
          "ims_stack_fork": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              }
            ]
          },
          "verdict": {
            "enum": [
              "proceed",
              "hold"
            ]
          },
          "reader": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "read_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "reference": {
            "type": "string",
            "pattern": "^devices/records/reads/group-a/[A-Za-z0-9_.]{1,200}\\.[0-9a-f]{12}\\.json$"
          }
        }
      }
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "finding",
          "verdict",
          "reader",
          "read_at",
          "reference"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,200}$"
          },
          "finding": {
            "const": "display_only"
          },
          "verdict": {
            "enum": [
              "proceed",
              "hold"
            ]
          },
          "reader": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "read_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "reference": {
            "type": "string",
            "pattern": "^devices/records/reads/group-a/[A-Za-z0-9_.]{1,200}\\.[0-9a-f]{12}\\.json$"
          }
        }
      }
    }
  }
}
