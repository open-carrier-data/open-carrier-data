{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-carrier-data/open-carrier-data/main/schemas/cell-records.schema.json",
  "title": "OCD cell records (generated/devices/device-records.json, schema_version 2)",
  "description": "Rule round 31 (keys): OCD's index is the carrier profile, and where a fact also depends on the device the index is the device and the carrier together. No record is keyed by device alone. A measured record belongs to one cell: the device (Build.DEVICE and model), the OCD carrier profile or MCC-MNC plus GID1 or SPN for a SIM without a profile, the ROM family and build line with its forks, and the IMS stack with its fork. It also states the build incremental and the stack version, which are recorded, not matched. The kind is measured only; a record without a carrier key is refused, and so is a group A or group B key. A record is served as a value only in its exact cell; in a neighbouring cell (same device and carrier, another ROM, build line, forks or stack) it may only be tried as the first candidate where a tester runs. record_key is r: plus the first 16 hex digits of SHA-256 over ten lines joined with \\n: kind, device codename, upper-cased model, ROM family, ROM line, the ROM forks joined with commas (empty for none), IMS stack id, IMS stack fork (empty for none), the carrier text (profile:<id>, sim:<mcc>-<mnc>:gid1=<upper GID1> or sim:<mcc>-<mnc>:spn=<SPN>) and the target text (config:<key>, apn:<row_key> or emergency_data:<row_key or default>). Records never hold a phone number, IMSI, ICCID, IMEI, SIP URI or IP address, and the index never names a SIM. Public main serves schema_version 1 (schemas/device-records.schema.json) until the readers on the phones parse schema_version 2; tools/ocd_dataset.py writes and checks both.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "based_on_data_digest",
    "expire_days",
    "records"
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_key",
        "kind",
        "device",
        "rom",
        "ims_stack",
        "carrier",
        "target",
        "value_kind",
        "value",
        "claim",
        "label",
        "basis",
        "level",
        "result",
        "method",
        "bearer",
        "n",
        "first_measured",
        "last_measured",
        "valid_until",
        "data",
        "tester",
        "differs_between_sims"
      ],
      "properties": {
        "record_key": {
          "type": "string",
          "pattern": "^r:[0-9a-f]{16}$"
        },
        "kind": {
          "const": "measured"
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codename",
            "model"
          ],
          "properties": {
            "codename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]{0,39}$"
            }
          }
        },
        "rom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "line",
            "forks",
            "incremental"
          ],
          "properties": {
            "family": {
              "enum": [
                "aosp",
                "lineageos",
                "other",
                "stock"
              ]
            },
            "line": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,15}$"
            },
            "forks": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "description": "The builder's forks of the ROM's own repositories that the result can depend on, as the build declares them (ocd-build.json rom.forks), sorted. Part of the cell."
            },
            "incremental": {
              "type": "string",
              "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$",
              "description": "Build.VERSION.INCREMENTAL of the build measured on. Recorded, not matched: a changed incremental makes the record due for a test at once on a phone with the tester."
            }
          }
        },
        "ims_stack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "fork",
            "version"
          ],
          "properties": {
            "id": {
              "enum": [
                "aosp_imsstack",
                "phh_ims",
                "samsung_ims",
                "other"
              ]
            },
            "fork": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ],
              "description": "The stack's version code at measurement. Recorded, not matched: a changed version makes the record due for a test at once."
            }
          }
        },
        "carrier": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "profile_id"
              ],
              "properties": {
                "scope": {
                  "const": "profile"
                },
                "profile_id": {
                  "type": "string",
                  "pattern": "^(open|fill)\\.[0-9]{5,6}\\.[0-9a-f]{12}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "mcc",
                "mnc"
              ],
              "properties": {
                "scope": {
                  "const": "sim_key"
                },
                "mcc": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                },
                "mnc": {
                  "type": "string",
                  "pattern": "^[0-9]{2,3}$"
                },
                "gid1": {
                  "type": "string",
                  "pattern": "^[0-9A-Fa-f]{1,32}$"
                },
                "spn": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key"
              ],
              "properties": {
                "type": {
                  "const": "config"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.]{1,200}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "row_key",
                "op"
              ],
              "properties": {
                "type": {
                  "const": "apn"
                },
                "row_key": {
                  "type": "string",
                  "pattern": "^a:[0-9a-f]{16}$"
                },
                "op": {
                  "const": "omit"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "row_key"
              ],
              "properties": {
                "type": {
                  "const": "emergency_data"
                },
                "row_key": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^a:[0-9a-f]{16}$"
                    }
                  ]
                }
              }
            }
          ]
        },
        "value_kind": {
          "enum": [
            "value",
            "android_default",
            "none"
          ]
        },
        "value": {
          "description": "A value of the registry type of target.key, or null when value_kind is not value."
        },
        "claim": {
          "const": "measured"
        },
        "label": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "level": {
          "enum": [
            null,
            "L2",
            "L3",
            "sms_both_ways",
            "no_regression",
            "emergency_data"
          ]
        },
        "result": {
          "enum": [
            null,
            "works",
            "calls_out",
            "sms_both_ways",
            "no_regression_passed",
            "winner_after_failure",
            "no_value_passed",
            "emergency_data_accepted",
            "emergency_data_refused",
            "emergency_default_won"
          ]
        },
        "method": {
          "enum": [
            null,
            "mailbox_call",
            "real_call",
            "mailbox_call+real_call",
            "real_call+real_call",
            "self_sms",
            "observed",
            "override_trial",
            "eims_request"
          ]
        },
        "bearer": {
          "enum": [
            null,
            "lte",
            "nr",
            "iwlan"
          ]
        },
        "n": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          ]
        },
        "first_measured": {
          "type": "string",
          "format": "date"
        },
        "last_measured": {
          "type": "string",
          "format": "date"
        },
        "valid_until": {
          "type": "string",
          "format": "date"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit",
            "data_digest"
          ],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "data_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "tester": {
          "const": "owner"
        },
        "differs_between_sims": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "last_measured"
                ],
                "properties": {
                  "value": {},
                  "last_measured": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "based_on_data_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expire_days": {
      "const": 90
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
